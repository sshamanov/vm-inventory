[Unit]
Description=Infrastructure Inventory Exporter
After=network-online.target
Wants=network-online.target

[Service]
# Self-update before start — exits 0 if already current.
ExecStartPre=/usr/local/bin/bin-update.sh inventory-exporter /usr/local/bin/inventory-exporter
ExecStart=/usr/local/bin/inventory-exporter
Restart=always
RestartSec=30

# Security hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/tmp
ReadOnlyPaths=/etc/inventory-exporter
ReadOnlyPaths=/proc /sys /etc/os-release /run

[Install]
WantedBy=multi-user.target
