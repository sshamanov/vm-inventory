[Unit]
Description=Infrastructure Inventory Exporter
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/bin-update.sh inventory-exporter /usr/local/bin/inventory-exporter
ExecStart=/usr/local/bin/inventory-exporter
Restart=always
RestartSec=30

# Resource limits.
MemoryMax=256M
CPUQuota=50%
TasksMax=20

[Install]
WantedBy=multi-user.target
