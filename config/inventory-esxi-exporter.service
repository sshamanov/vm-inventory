[Unit]
Description=Infrastructure Inventory ESXi Exporter
After=network-online.target docker.service
Wants=network-online.target docker.service
Requires=docker.service

[Service]
# Pull latest image, then run with ESXi config mounted read-only.
ExecStartPre=-/usr/bin/docker pull ghcr.io/sshamanov/inventory-exporter:latest
ExecStartPre=-/usr/bin/docker rm -f inventory-esxi-exporter
ExecStart=/usr/bin/docker run \
  --name inventory-esxi-exporter \
  --network host \
  --restart no \
  --read-only \
  -v /etc/inventory-exporter/esxi.yaml:/etc/inventory-exporter/config.yaml:ro \
  ghcr.io/sshamanov/inventory-exporter:latest

ExecStop=/usr/bin/docker stop inventory-esxi-exporter
ExecStopPost=/usr/bin/docker rm -f inventory-esxi-exporter

Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
